    <script>
        /* State Initialization and Local Storage Handling */
        const STORAGE_KEY = 'casal_finance_data_v1';
        
        // Initial state template with seed data for August 2026 and July 2026 for demonstration
        const defaultState = {
            theme: 'dark',
            goals: [
                { id: 'g1', name: 'Reserva de Emergência', target: 20000, current: 8500, deadline: '2026-12-31' },
                { id: 'g2', name: 'Viagem de Fim de Ano', target: 6000, current: 3200, deadline: '2026-11-15' },
