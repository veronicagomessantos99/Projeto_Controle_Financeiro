        function quickAddGoalMoney(id) {
            const goal = appData.goals.find(g => g.id === id);
            if (!goal) return;
            const amountStr = prompt(`Quanto deseja adicionar para a meta "${goal.name}"?`);
            if (amountStr && !isNaN(parseFloat(amountStr))) {
                const add = parseFloat(amountStr);
                goal.current += add;
                renderGoalsGrid();
                saveState();
                showToast(`Adicionado ${formatBRL(add)} à meta!`);
            }
        }

