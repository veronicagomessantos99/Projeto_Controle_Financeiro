                    ],
                    fixed: [
                        { id: 'fix1', desc: 'Aluguel / Condomínio', amount: 2200, date: 'Dia 05', category: 'Moradia / Utilidades', source: 'RENDA', status: true },
                        { id: 'fix2', desc: 'Energia Elétrica', amount: 280, date: 'Dia 10', category: 'Moradia / Utilidades', source: 'RENDA', status: true },
                        { id: 'fix3', desc: 'Internet Fibra', amount: 120, date: 'Dia 15', category: 'Moradia / Utilidades', source: 'RENDA', status: false },
                        { id: 'fix4', desc: 'Plano de Saúde', amount: 650, date: 'Dia 20', category: 'Farmácia / Saúde', source: 'RENDA', status: false }
                    ],
                    variable: [
                        { id: 'var1', desc: 'Compras Supermercado', amount: 650, date: '03/08', category: 'Supermercado / Mercado', source: 'VA' },
                        { id: 'var2', desc: 'Almoço de Domingo', amount: 180, date: '05/08', category: 'Restaurantes / Lanches', source: 'VR' },
                        { id: 'var3', desc: 'Combustível Carro', amount: 250, date: '08/08', category: 'Transporte / Combustível', source: 'RENDA' },
                        { id: 'var4', desc: 'Remédios Farmácia', amount: 95, date: '11/08', category: 'Farmácia / Saúde', source: 'RENDA' }
                    ],
                    events: [
                        { id: 'evt1', desc: 'Dia das Mães / Almoço Especial', amount: 400, date: '10/08', category: 'Presentes / Festas', source: 'RENDA', status: true },
                        { id: 'evt2', desc: 'Aniversário de Casamento', amount: 350, date: '25/08', category: 'Presentes / Festas', source: 'RENDA', status: false }
                    ]
                },
                '2026-07': {
                    income: [
                        { id: 'inc1', desc: 'Salário Marido', amount: 4500, type: 'RENDA', person: 'Marido' },
                        { id: 'inc2', desc: 'Salário Esposa', amount: 4200, type: 'RENDA', person: 'Esposa' },
                        { id: 'inc3', desc: 'Vale Alimentação (VA)', amount: 1000, type: 'VA', person: 'Casal / Conjunto' },
                        { id: 'inc4', desc: 'Vale Refeição (VR)', amount: 700, type: 'VR', person: 'Casal / Conjunto' }
                    ],
                    fixed: [
                        { id: 'fix1', desc: 'Aluguel / Condomínio', amount: 2200, date: 'Dia 05', category: 'Moradia / Utilidades', source: 'RENDA', status: true },
                        { id: 'fix2', desc: 'Energia Elétrica', amount: 310, date: 'Dia 10', category: 'Moradia / Utilidades', source: 'RENDA', status: true },
                        { id: 'fix3', desc: 'Internet Fibra', amount: 120, date: 'Dia 15', category: 'Moradia / Utilidades', source: 'RENDA', status: true }
                    ],
                    variable: [
                        { id: 'var1', desc: 'Feira e Mercado', amount: 920, date: '12/07', category: 'Supermercado / Mercado', source: 'VA' },
                        { id: 'var2', desc: 'Jantares Fora', amount: 550, date: '20/07', category: 'Restaurantes / Lanches', source: 'VR' }
                    ],
                    events: [
                        { id: 'evt1', desc: 'Festa Julina Família', amount: 250, date: '18/07', category: 'Presentes / Festas', source: 'RENDA', status: true }
                    ]
                }
            }
        };

        let appData = loadState();
        let currentMonthKey = '2026-08';
        let chartInstance = null;

        // Save & Load Functions
        function loadState() {
            try {
                const stored = localStorage.getItem(STORAGE_KEY);
                if (stored) return JSON.parse(stored);
            } catch (e) {
                console.warn('Unable to load from localStorage', e);
            }
            return defaultState;
        }

        function saveState() {
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(appData));
            } catch (e) {
                console.warn('Unable to save to localStorage', e);
            }
        }

        // Format Currency BRL
        function formatBRL(value) {
            return new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(value || 0);
        }

        // Ensure Month Data Exists
        function getMonthData(key) {
            if (!appData.months[key]) {
                appData.months[key] = {
                    income: [
                        { id: 'inc1_' + Date.now(), desc: 'Salário Marido', amount: 4500, type: 'RENDA', person: 'Marido' },
                        { id: 'inc2_' + Date.now(), desc: 'Salário Esposa', amount: 4200, type: 'RENDA', person: 'Esposa' },
                        { id: 'inc3_' + Date.now(), desc: 'Vale Alimentação (VA)', amount: 1000, type: 'VA', person: 'Casal / Conjunto' },
                        { id: 'inc4_' + Date.now(), desc: 'Vale Refeição (VR)', amount: 700, type: 'VR', person: 'Casal / Conjunto' }
                    ],
                    fixed: [],
                    variable: [],
                    events: []
                };
            }
            return appData.months[key];
        }

        /* App Initialization */
        window.addEventListener('DOMContentLoaded', () => {
            // Apply theme
            if (appData.theme === 'dark') {
                document.documentElement.classList.add('dark');
                document.getElementById('themeIcon').className = 'fa-solid fa-sun';
            } else {
                document.documentElement.classList.remove('dark');
                document.getElementById('themeIcon').className = 'fa-solid fa-moon';
            }

            // Set default month picker
            const monthInput = document.getElementById('monthPicker');
            monthInput.value = currentMonthKey;

            // Initial render
            renderAll();
        });

        function toggleTheme() {
            const html = document.documentElement;
            const icon = document.getElementById('themeIcon');
            if (html.classList.contains('dark')) {
                html.classList.remove('dark');
                icon.className = 'fa-solid fa-moon';
                appData.theme = 'light';
            } else {
                html.classList.add('dark');
                icon.className = 'fa-solid fa-sun';
                appData.theme = 'dark';
            }
            saveState();
            if (chartInstance) renderComparisonChart();
        }

        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.className = 'tab-btn px-3 py-2 text-sm font-medium rounded-lg flex items-center gap-2 transition text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white';
            });

            document.getElementById('content-' + tabId).classList.remove('hidden');
            const activeBtn = document.getElementById('tab-' + tabId);
            if (activeBtn) {
                activeBtn.className = 'tab-btn px-3 py-2 text-sm font-medium rounded-lg flex items-center gap-2 transition text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/40 font-semibold';
            }

            if (tabId === 'comparison') {
                renderComparisonTab();
            }
        }

        function onMonthSelect(val) {
            if (!val) return;
            currentMonthKey = val;
            renderAll();
            showToast('Mês alterado para ' + val);
        }

        function changeMonth(offset) {
            const [year, month] = currentMonthKey.split('-').map(Number);
            const date = new Date(year, month - 1 + offset, 1);
            const y = date.getFullYear();
            const m = String(date.getMonth() + 1).padStart(2, '0');
            currentMonthKey = `${y}-${m}`;
            document.getElementById('monthPicker').value = currentMonthKey;
            renderAll();
        }

        /* Render Core Logic */
        function renderAll() {
            const month = getMonthData(currentMonthKey);
            
            // Calculate Totals
            let totalCashIncome = 0;
            let totalVAIncome = 0;
            let totalVRIncome = 0;

            month.income.forEach(item => {
                if (item.type === 'RENDA') totalCashIncome += item.amount;
                else if (item.type === 'VA') totalVAIncome += item.amount;
                else if (item.type === 'VR') totalVRIncome += item.amount;
            });

            // Calculate Expenses per source
            let cashSpent = 0;
            let vaSpent = 0;
            let vrSpent = 0;

            let fixedSpent = 0;
            let eventSpent = 0;

            // Fixed expenses (Always deducted from RENDA unless specified)
            month.fixed.forEach(item => {
                fixedSpent += item.amount;
                if (item.source === 'VA') vaSpent += item.amount;
                else if (item.source === 'VR') vrSpent += item.amount;
                else cashSpent += item.amount;
            });

            // Variable expenses
            month.variable.forEach(item => {
                if (item.source === 'VA') vaSpent += item.amount;
                else if (item.source === 'VR') vrSpent += item.amount;
                else cashSpent += item.amount;
            });

            // Event expenses
            month.events.forEach(item => {
                eventSpent += item.amount;
                if (item.source === 'VA') vaSpent += item.amount;
                else if (item.source === 'VR') vrSpent += item.amount;
                else cashSpent += item.amount;
            });

            const totalExpenses = cashSpent + vaSpent + vrSpent;

            // Balances
            const cashBalance = totalCashIncome - cashSpent;
            const vaBalance = totalVAIncome - vaSpent;
            const vrBalance = totalVRIncome - vrSpent;

            // Render Dashboard Cards
            document.getElementById('dash-cash-balance').innerText = formatBRL(cashBalance);
            document.getElementById('dash-cash-income').innerText = formatBRL(totalCashIncome);
            document.getElementById('dash-cash-spent').innerText = formatBRL(cashSpent);

            document.getElementById('dash-va-balance').innerText = formatBRL(vaBalance);
            document.getElementById('dash-va-income').innerText = formatBRL(totalVAIncome);
            document.getElementById('dash-va-spent').innerText = formatBRL(vaSpent);

            document.getElementById('dash-vr-balance').innerText = formatBRL(vrBalance);
            document.getElementById('dash-vr-income').innerText = formatBRL(totalVRIncome);
            document.getElementById('dash-vr-spent').innerText = formatBRL(vrSpent);

            document.getElementById('dash-total-expenses').innerText = formatBRL(totalExpenses);
            document.getElementById('dash-fixed-spent').innerText = formatBRL(fixedSpent);
            document.getElementById('dash-event-spent').innerText = formatBRL(eventSpent);

            // VA Progress Bar
            const vaPercent = totalVAIncome > 0 ? Math.min(100, Math.round((vaSpent / totalVAIncome) * 100)) : 0;
            document.getElementById('dash-va-percent').innerText = `${vaPercent}% utilizado`;
            document.getElementById('dash-va-bar').style.width = `${vaPercent}%`;
            document.getElementById('dash-va-detail-spent').innerText = `Gastos Alimentícios: ${formatBRL(vaSpent)}`;
            document.getElementById('dash-va-detail-rem').innerText = `Disponível: ${formatBRL(vaBalance)}`;

            // VR Progress Bar
            const vrPercent = totalVRIncome > 0 ? Math.min(100, Math.round((vrSpent / totalVRIncome) * 100)) : 0;
            document.getElementById('dash-vr-percent').innerText = `${vrPercent}% utilizado`;
            document.getElementById('dash-vr-bar').style.width = `${vrPercent}%`;
            document.getElementById('dash-vr-detail-spent').innerText = `Gastos Refeição: ${formatBRL(vrSpent)}`;
            document.getElementById('dash-vr-detail-rem').innerText = `Disponível: ${formatBRL(vrBalance)}`;

            // Cash Progress Bar
            const cashPercent = totalCashIncome > 0 ? Math.min(100, Math.round((cashSpent / totalCashIncome) * 100)) : 0;
            document.getElementById('dash-cash-percent').innerText = `${cashPercent}% comprometido`;
            document.getElementById('dash-cash-bar').style.width = `${cashPercent}%`;
            document.getElementById('dash-cash-detail-spent').innerText = `Gastos Gerais: ${formatBRL(cashSpent)}`;
            document.getElementById('dash-cash-detail-rem').innerText = `Livre: ${formatBRL(cashBalance)}`;

            // Render Tables
            renderIncomeTable(month.income);
            renderFixedTable(month.fixed);
            renderVariableTable();
            renderEventsGrid(month.events);
            renderGoalsGrid();

            saveState();
        }

