        function renderComparisonChart() {
            const ctx = document.getElementById('comparisonChart');
            if (!ctx) return;

            const keys = Object.keys(appData.months).sort();
            const incomes = [];
            const expenses = [];

            keys.forEach(k => {
                const m = appData.months[k];
                let inc = 0, exp = 0;
                m.income.forEach(i => inc += i.amount);
                m.fixed.forEach(i => exp += i.amount);
                m.variable.forEach(i => exp += i.amount);
                m.events.forEach(i => exp += i.amount);
                incomes.push(inc);
                expenses.push(exp);
            });

            if (chartInstance) {
                chartInstance.destroy();
            }

            const isDark = document.documentElement.classList.contains('dark');

            chartInstance = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: keys,
                    datasets: [
                        {
                            label: 'Renda Total (R$)',
                            data: incomes,
                            backgroundColor: '#10b981',
                            borderRadius: 6
                        },
                        {
                            label: 'Gastos Totais (R$)',
                            data: expenses,
                            backgroundColor: '#f43f5e',
                            borderRadius: 6
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            labels: {
                                color: isDark ? '#e5e7eb' : '#374151',
                                font: { family: 'Inter' }
                            }
                        }
                    },
                    scales: {
                        x: {
                            ticks: { color: isDark ? '#9ca3af' : '#6b7280' },
                            grid: { display: false }
                        },
                        y: {
                            ticks: { color: isDark ? '#9ca3af' : '#6b7280' },
                            grid: { color: isDark ? '#374151' : '#e5e7eb' }
                        }
                    }
                }
            });
        }

        function openModal(type, itemId = null) {
            const month = getMonthData(currentMonthKey);
            document.getElementById('modalType').value = type;
            document.getElementById('modalItemId').value = itemId || '';

            // Fields visibility logic based on entry type
            const catContainer = document.getElementById('fieldCategoryContainer');
            const sourceContainer = document.getElementById('fieldSourceContainer');
            const personContainer = document.getElementById('fieldPersonContainer');
            const statusContainer = document.getElementById('fieldStatusContainer');

            // Reset
            catContainer.classList.add('hidden');
            sourceContainer.classList.add('hidden');
            personContainer.classList.add('hidden');
            statusContainer.classList.add('hidden');

            const title = document.getElementById('modalTitle');

            if (type === 'income') {
                title.innerText = itemId ? 'Editar Recebimento / Vale' : 'Adicionar Recebimento / Vale';
                sourceContainer.classList.remove('hidden');
                personContainer.classList.remove('hidden');
                document.getElementById('labelDate').innerText = 'Data do Recebimento';

                if (itemId) {
                    const item = month.income.find(i => i.id === itemId);
                    if (item) {
                        document.getElementById('formDesc').value = item.desc;
                        document.getElementById('formAmount').value = item.amount;
                        document.getElementById('formSource').value = item.type;
                        document.getElementById('formPerson').value = item.person;
                    }
                } else {
                    document.getElementById('itemForm').reset();
                }
            } else if (type === 'fixed') {
                title.innerText = itemId ? 'Editar Conta Fixa' : 'Adicionar Conta Fixa';
                catContainer.classList.remove('hidden');
                sourceContainer.classList.remove('hidden');
                statusContainer.classList.remove('hidden');
                document.getElementById('labelDate').innerText = 'Dia do Vencimento';

                if (itemId) {
                    const item = month.fixed.find(i => i.id === itemId);
                    if (item) {
                        document.getElementById('formDesc').value = item.desc;
                        document.getElementById('formAmount').value = item.amount;
                        document.getElementById('formDate').value = item.date || '';
                        document.getElementById('formCategory').value = item.category || 'Moradia / Utilidades';
                        document.getElementById('formSource').value = item.source || 'RENDA';
                        document.getElementById('formStatus').checked = !!item.status;
                    }
                } else {
                    document.getElementById('itemForm').reset();
                }
            } else if (type === 'variable') {
                title.innerText = itemId ? 'Editar Gasto Variável' : 'Lançar Gasto Variável';
                catContainer.classList.remove('hidden');
                sourceContainer.classList.remove('hidden');
                document.getElementById('labelDate').innerText = 'Data da Compra';

                if (itemId) {
                    const item = month.variable.find(i => i.id === itemId);
                    if (item) {
                        document.getElementById('formDesc').value = item.desc;
                        document.getElementById('formAmount').value = item.amount;
                        document.getElementById('formDate').value = item.date || '';
                        document.getElementById('formCategory').value = item.category || 'Supermercado / Mercado';
                        document.getElementById('formSource').value = item.source || 'VA';
                    }
                } else {
                    document.getElementById('itemForm').reset();
                    autoUpdatePaymentSource();
                }
            } else if (type === 'events') {
                title.innerText = itemId ? 'Editar Evento / Festa' : 'Planejar Novo Evento';
                sourceContainer.classList.remove('hidden');
                document.getElementById('labelDate').innerText = 'Data do Evento';

                if (itemId) {
                    const item = month.events.find(i => i.id === itemId);
                    if (item) {
                        document.getElementById('formDesc').value = item.desc;
                        document.getElementById('formAmount').value = item.amount;
                        document.getElementById('formDate').value = item.date || '';
                        document.getElementById('formSource').value = item.source || 'RENDA';
                    }
                } else {
                    document.getElementById('itemForm').reset();
                }
            }

            document.getElementById('itemModal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('itemModal').classList.add('hidden');
        }

        // Auto selection for Payment Source based on Category Rules
        function autoUpdatePaymentSource() {
            const cat = document.getElementById('formCategory').value;
            const sourceSelect = document.getElementById('formSource');
            const type = document.getElementById('modalType').value;

            if (type === 'variable' || type === 'fixed') {
                if (cat === 'Supermercado / Mercado') {
                    sourceSelect.value = 'VA';
                } else if (cat === 'Restaurantes / Lanches') {
                    sourceSelect.value = 'VR';
                } else {
                    sourceSelect.value = 'RENDA';
                }
            }
        }

        function handleFormSubmit(event) {
            event.preventDefault();
            const type = document.getElementById('modalType').value;
            const itemId = document.getElementById('modalItemId').value;
            const month = getMonthData(currentMonthKey);

            const desc = document.getElementById('formDesc').value;
            const amount = parseFloat(document.getElementById('formAmount').value) || 0;
            const date = document.getElementById('formDate').value;
            const category = document.getElementById('formCategory').value;
            const source = document.getElementById('formSource').value;
            const person = document.getElementById('formPerson').value;
            const status = document.getElementById('formStatus').checked;

            // Enforce VA/VR restriction validation
            if ((source === 'VA' && category !== 'Supermercado / Mercado') || 
                (source === 'VR' && category !== 'Restaurantes / Lanches')) {
                if (type === 'variable' || type === 'fixed') {
                    showToast('Atenção: VA e VR são aceitos apenas em Mercado e Restaurantes!', 'warning');
                }
            }

            if (type === 'income') {
                if (itemId) {
                    const idx = month.income.findIndex(i => i.id === itemId);
                    if (idx !== -1) month.income[idx] = { id: itemId, desc, amount, type: source, person };
                } else {
                    month.income.push({ id: 'inc_' + Date.now(), desc, amount, type: source, person });
                }
            } else if (type === 'fixed') {
                if (itemId) {
                    const idx = month.fixed.findIndex(i => i.id === itemId);
                    if (idx !== -1) month.fixed[idx] = { id: itemId, desc, amount, date, category, source, status };
                } else {
                    month.fixed.push({ id: 'fix_' + Date.now(), desc, amount, date, category, source, status });
                }
            } else if (type === 'variable') {
                if (itemId) {
                    const idx = month.variable.findIndex(i => i.id === itemId);
                    if (idx !== -1) month.variable[idx] = { id: itemId, desc, amount, date, category, source };
                } else {
                    month.variable.push({ id: 'var_' + Date.now(), desc, amount, date, category, source });
                }
            } else if (type === 'events') {
                if (itemId) {
                    const idx = month.events.findIndex(i => i.id === itemId);
                    if (idx !== -1) month.events[idx] = { id: itemId, desc, amount, date, category: 'Presentes / Festas', source, status: false };
                } else {
                    month.events.push({ id: 'evt_' + Date.now(), desc, amount, date, category: 'Presentes / Festas', source, status: false });
                }
            }

            closeModal();
            renderAll();
            showToast('Lançamento salvo com sucesso!');
        }

        function deleteItem(type, itemId) {
            const month = getMonthData(currentMonthKey);
            if (type === 'income') month.income = month.income.filter(i => i.id !== itemId);
            if (type === 'fixed') month.fixed = month.fixed.filter(i => i.id !== itemId);
            if (type === 'variable') month.variable = month.variable.filter(i => i.id !== itemId);
            if (type === 'events') month.events = month.events.filter(i => i.id !== itemId);

            renderAll();
            showToast('Item removido com sucesso.');
        }

        function openGoalModal(goalId = null) {
            document.getElementById('goalId').value = goalId || '';
            const title = document.getElementById('goalModalTitle');

            if (goalId) {
                title.innerText = 'Editar Meta Financeira';
                const goal = appData.goals.find(g => g.id === goalId);
                if (goal) {
                    document.getElementById('goalName').value = goal.name;
                    document.getElementById('goalTarget').value = goal.target;
                    document.getElementById('goalCurrent').value = goal.current;
                    document.getElementById('goalDeadline').value = goal.deadline || '';
                }
            } else {
                title.innerText = 'Nova Meta Financeira';
                document.getElementById('goalForm').reset();
            }

            document.getElementById('goalModal').classList.remove('hidden');
        }

        function closeGoalModal() {
            document.getElementById('goalModal').classList.add('hidden');
        }

        function handleGoalSubmit(event) {
            event.preventDefault();
            const goalId = document.getElementById('goalId').value;
            const name = document.getElementById('goalName').value;
            const target = parseFloat(document.getElementById('goalTarget').value) || 0;
            const current = parseFloat(document.getElementById('goalCurrent').value) || 0;
            const deadline = document.getElementById('goalDeadline').value;

            if (goalId) {
                const idx = appData.goals.findIndex(g => g.id === goalId);
                if (idx !== -1) appData.goals[idx] = { id: goalId, name, target, current, deadline };
            } else {
                appData.goals.push({ id: 'g_' + Date.now(), name, target, current, deadline });
            }

            closeGoalModal();
            renderGoalsGrid();
            saveState();
            showToast('Meta financeira atualizada!');
        }

        function deleteGoal(goalId) {
            appData.goals = appData.goals.filter(g => g.id !== goalId);
            renderGoalsGrid();
            saveState();
            showToast('Meta removida.');
        }

        // Toast Feedback Function
        function showToast(msg, type = 'success') {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toastMsg');
            const toastIcon = document.getElementById('toastIcon');

            toastMsg.innerText = msg;
            if (type === 'warning') {
                toastIcon.className = 'fa-solid fa-triangle-exclamation text-amber-400 dark:text-amber-500';
            } else {
                toastIcon.className = 'fa-solid fa-circle-check text-emerald-400 dark:text-emerald-600';
            }

            toast.classList.remove('opacity-0', 'translate-y-10', 'pointer-events-none');
            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-10', 'pointer-events-none');
            }, 3000);
        }
    </script>
</body>
</html>
