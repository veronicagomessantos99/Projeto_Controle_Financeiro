<!DOCTYPE html>
<html lang="pt-BR" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Controle Financeiro Familiar</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            900: '#312e81',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Chart.js for Monthly Comparisons -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        /* Custom scrollbars */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.05);
        }
        .dark ::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(156, 163, 175, 0.5);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(107, 114, 128, 0.8);
        }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 dark:bg-gray-900 dark:text-gray-100 min-h-screen transition-colors duration-200 flex flex-col">

    <!-- Top Navigation Header -->
    <header class="bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 sticky top-0 z-30 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <!-- Logo & Title -->
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-500 to-purple-600 flex items-center justify-center text-white shadow-md">
                        <i class="fa-solid fa-wallet text-xl"></i>
                    </div>
                    <div>
                        <h1 class="text-lg font-bold leading-none text-gray-900 dark:text-white">Finanças do Casal</h1>
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Gestão de Rendas, Vales e Gastos</p>
                    </div>
                </div>

                <!-- Month Selector & Controls -->
                <div class="flex items-center space-x-3">
                    <div class="relative flex items-center bg-gray-100 dark:bg-gray-700 rounded-lg p-1 text-sm">
                        <button onclick="changeMonth(-1)" class="p-1.5 hover:bg-white dark:hover:bg-gray-600 rounded-md transition text-gray-600 dark:text-gray-200" title="Mês anterior">
                            <i class="fa-solid fa-chevron-left text-xs"></i>
                        </button>
                        <input type="month" id="monthPicker" onchange="onMonthSelect(this.value)" class="bg-transparent border-none text-center font-semibold text-gray-700 dark:text-gray-200 focus:outline-none cursor-pointer px-2 text-xs sm:text-sm">
                        <button onclick="changeMonth(1)" class="p-1.5 hover:bg-white dark:hover:bg-gray-600 rounded-md transition text-gray-600 dark:text-gray-200" title="Próximo mês">
                            <i class="fa-solid fa-chevron-right text-xs"></i>
                        </button>
                    </div>

                    <!-- Dark Mode Toggle Button -->
                    <button id="themeToggleBtn" onclick="toggleTheme()" class="p-2.5 rounded-lg bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-600 dark:text-gray-200 transition focus:outline-none" title="Alternar Tema Escuro">
                        <i id="themeIcon" class="fa-solid fa-moon"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-gray-100 dark:border-gray-700/60 overflow-x-auto">
            <nav class="flex space-x-2 sm:space-x-6 py-2 min-w-max" id="navTabs">
                <button onclick="switchTab('dashboard')" id="tab-dashboard" class="tab-btn px-3 py-2 text-sm font-medium rounded-lg flex items-center gap-2 transition text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/40">
                    <i class="fa-solid fa-chart-pie"></i> Visão Geral
                </button>
                <button onclick="switchTab('income')" id="tab-income" class="tab-btn px-3 py-2 text-sm font-medium rounded-lg flex items-center gap-2 transition text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white">
                    <i class="fa-solid fa-money-bill-wave"></i> Recebimentos & Vales
                </button>
                <button onclick="switchTab('fixed')" id="tab-fixed" class="tab-btn px-3 py-2 text-sm font-medium rounded-lg flex items-center gap-2 transition text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white">
                    <i class="fa-solid fa-calendar-check"></i> Contas Fixas
                </button>
                <button onclick="switchTab('variable')" id="tab-variable" class="tab-btn px-3 py-2 text-sm font-medium rounded-lg flex items-center gap-2 transition text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white">
                    <i class="fa-solid fa-cart-shopping"></i> Gastos Variados
                </button>
                <button onclick="switchTab('events')" id="tab-events" class="tab-btn px-3 py-2 text-sm font-medium rounded-lg flex items-center gap-2 transition text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white">
                    <i class="fa-solid fa-gift"></i> Eventos & Festas
                </button>
                <button onclick="switchTab('comparison')" id="tab-comparison" class="tab-btn px-3 py-2 text-sm font-medium rounded-lg flex items-center gap-2 transition text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white">
                    <i class="fa-solid fa-chart-column"></i> Comparativo Mensal
                </button>
                <button onclick="switchTab('goals')" id="tab-goals" class="tab-btn px-3 py-2 text-sm font-medium rounded-lg flex items-center gap-2 transition text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white">
                    <i class="fa-solid fa-bullseye"></i> Metas Financeiras
                </button>
            </nav>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-grow w-full">
        
        <!-- ================= DASHBOARD TAB ================= -->
        <section id="content-dashboard" class="tab-content space-y-6">
            <!-- Summary Balance Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <!-- Renda Principal -->
                <div class="bg-white dark:bg-gray-800 rounded-2xl p-5 border border-gray-200 dark:border-gray-700 shadow-sm relative overflow-hidden">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Saldo Renda em Conta</p>
                            <h3 class="text-2xl font-bold mt-1 text-gray-900 dark:text-white" id="dash-cash-balance">R$ 0,00</h3>
                        </div>
                        <div class="p-3 bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 rounded-xl">
                            <i class="fa-solid fa-building-columns text-xl"></i>
                        </div>
                    </div>
                    <div class="mt-4 pt-3 border-t border-gray-100 dark:border-gray-700/60 flex justify-between text-xs text-gray-500 dark:text-gray-400">
                        <span>Renda Total: <strong id="dash-cash-income" class="text-gray-700 dark:text-gray-300">R$ 0,00</strong></span>
                        <span>Gastos: <strong id="dash-cash-spent" class="text-red-500">R$ 0,00</strong></span>
                    </div>
                </div>

                <!-- Vale Alimentação (VA) -->
                <div class="bg-white dark:bg-gray-800 rounded-2xl p-5 border border-gray-200 dark:border-gray-700 shadow-sm relative overflow-hidden">
                    <div class="flex justify-between items-start">
                        <div>
                            <div class="flex items-center gap-1.5">
                                <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Saldo Vale Alimentação (VA)</p>
                                <span class="text-[10px] bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 px-1.5 py-0.5 rounded font-medium">Mercado</span>
                            </div>
                            <h3 class="text-2xl font-bold mt-1 text-gray-900 dark:text-white" id="dash-va-balance">R$ 0,00</h3>
                        </div>
                        <div class="p-3 bg-blue-100 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 rounded-xl">
                            <i class="fa-solid fa-cart-shopping text-xl"></i>
                        </div>
                    </div>
                    <div class="mt-4 pt-3 border-t border-gray-100 dark:border-gray-700/60 flex justify-between text-xs text-gray-500 dark:text-gray-400">
                        <span>Entrada: <strong id="dash-va-income" class="text-gray-700 dark:text-gray-300">R$ 0,00</strong></span>
                        <span>Usado: <strong id="dash-va-spent" class="text-red-500">R$ 0,00</strong></span>
                    </div>
                </div>

                <!-- Vale Refeição (VR) -->
                <div class="bg-white dark:bg-gray-800 rounded-2xl p-5 border border-gray-200 dark:border-gray-700 shadow-sm relative overflow-hidden">
                    <div class="flex justify-between items-start">
                        <div>
                            <div class="flex items-center gap-1.5">
                                <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Saldo Vale Refeição (VR)</p>
                                <span class="text-[10px] bg-orange-100 dark:bg-orange-900/40 text-orange-700 dark:text-orange-300 px-1.5 py-0.5 rounded font-medium">Restaurantes</span>
                            </div>
                            <h3 class="text-2xl font-bold mt-1 text-gray-900 dark:text-white" id="dash-vr-balance">R$ 0,00</h3>
                        </div>
                        <div class="p-3 bg-orange-100 dark:bg-orange-950/60 text-orange-600 dark:text-orange-400 rounded-xl">
                            <i class="fa-solid fa-utensils text-xl"></i>
                        </div>
                    </div>
                    <div class="mt-4 pt-3 border-t border-gray-100 dark:border-gray-700/60 flex justify-between text-xs text-gray-500 dark:text-gray-400">
                        <span>Entrada: <strong id="dash-vr-income" class="text-gray-700 dark:text-gray-300">R$ 0,00</strong></span>
                        <span>Usado: <strong id="dash-vr-spent" class="text-red-500">R$ 0,00</strong></span>
                    </div>
                </div>

                <!-- Total Gastos Consolidados -->
                <div class="bg-white dark:bg-gray-800 rounded-2xl p-5 border border-gray-200 dark:border-gray-700 shadow-sm relative overflow-hidden">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Gastos Totais do Mês</p>
                            <h3 class="text-2xl font-bold mt-1 text-gray-900 dark:text-white" id="dash-total-expenses">R$ 0,00</h3>
                        </div>
                        <div class="p-3 bg-rose-100 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 rounded-xl">
                            <i class="fa-solid fa-file-invoice-dollar text-xl"></i>
                        </div>
                    </div>
                    <div class="mt-4 pt-3 border-t border-gray-100 dark:border-gray-700/60 flex justify-between text-xs text-gray-500 dark:text-gray-400">
                        <span>Contas Fixas: <strong id="dash-fixed-spent">R$ 0,00</strong></span>
                        <span>Eventos: <strong id="dash-event-spent">R$ 0,00</strong></span>
                    </div>
                </div>
            </div>

            <!-- Dashboard Detail Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Direct Source Breakdown -->
                <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 border border-gray-200 dark:border-gray-700 shadow-sm lg:col-span-2">
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4 flex items-center justify-between">
                        <span><i class="fa-solid fa-list-check text-indigo-500 mr-2"></i>Resumo do Desconto por Fonte de Pagamento</span>
                        <span class="text-xs font-normal text-gray-500 dark:text-gray-400">Regra: Vales exclusivos para Alimentação</span>
                    </h3>
                    <div class="space-y-4">
                        <!-- VA Health Bar -->
                        <div class="p-4 rounded-xl bg-gray-50 dark:bg-gray-700/50 border border-gray-200 dark:border-gray-600">
                            <div class="flex justify-between items-center mb-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-semibold text-sm text-gray-800 dark:text-gray-200">Vale Alimentação (VA)</span>
                                    <span class="text-xs text-gray-500 dark:text-gray-400">(Mercado / Supermercado)</span>
                                </div>
                                <span class="text-xs font-semibold" id="dash-va-percent">0% utilizado</span>
                            </div>
                            <div class="w-full bg-gray-200 dark:bg-gray-600 rounded-full h-2.5 overflow-hidden">
                                <div id="dash-va-bar" class="bg-blue-600 h-2.5 rounded-full transition-all duration-500" style="width: 0%"></div>
                            </div>
                            <div class="flex justify-between text-xs text-gray-500 dark:text-gray-400 mt-2">
                                <span id="dash-va-detail-spent">Gastos Alimentícios: R$ 0,00</span>
                                <span id="dash-va-detail-rem">Disponível: R$ 0,00</span>
                            </div>
                        </div>

                        <!-- VR Health Bar -->
                        <div class="p-4 rounded-xl bg-gray-50 dark:bg-gray-700/50 border border-gray-200 dark:border-gray-600">
                            <div class="flex justify-between items-center mb-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-semibold text-sm text-gray-800 dark:text-gray-200">Vale Refeição (VR)</span>
                                    <span class="text-xs text-gray-500 dark:text-gray-400">(Restaurantes / Refeições Prontas)</span>
                                </div>
                                <span class="text-xs font-semibold" id="dash-vr-percent">0% utilizado</span>
                            </div>
                            <div class="w-full bg-gray-200 dark:bg-gray-600 rounded-full h-2.5 overflow-hidden">
                                <div id="dash-vr-bar" class="bg-orange-500 h-2.5 rounded-full transition-all duration-500" style="width: 0%"></div>
                            </div>
                            <div class="flex justify-between text-xs text-gray-500 dark:text-gray-400 mt-2">
                                <span id="dash-vr-detail-spent">Gastos Refeição: R$ 0,00</span>
                                <span id="dash-vr-detail-rem">Disponível: R$ 0,00</span>
                            </div>
                        </div>

                        <!-- Regular Income Bar -->
                        <div class="p-4 rounded-xl bg-gray-50 dark:bg-gray-700/50 border border-gray-200 dark:border-gray-600">
                            <div class="flex justify-between items-center mb-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-semibold text-sm text-gray-800 dark:text-gray-200">Renda Principal (Salários / Outros)</span>
                                    <span class="text-xs text-gray-500 dark:text-gray-400">(Contas Fixas, Eventos e Geral)</span>
                                </div>
                                <span class="text-xs font-semibold" id="dash-cash-percent">0% comprometido</span>
                            </div>
                            <div class="w-full bg-gray-200 dark:bg-gray-600 rounded-full h-2.5 overflow-hidden">
                                <div id="dash-cash-bar" class="bg-emerald-500 h-2.5 rounded-full transition-all duration-500" style="width: 0%"></div>
                            </div>
                            <div class="flex justify-between text-xs text-gray-500 dark:text-gray-400 mt-2">
                                <span id="dash-cash-detail-spent">Gastos Gerais: R$ 0,00</span>
                                <span id="dash-cash-detail-rem">Livre: R$ 0,00</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Fast Actions & Highlights -->
                <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 border border-gray-200 dark:border-gray-700 shadow-sm flex flex-col justify-between">
                    <div>
                        <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-3">Atalhos Rápido</h3>
                        <p class="text-xs text-gray-500 dark:text-gray-400 mb-4">Adicione entradas e despesas rapidamente para este mês sem sair da tela.</p>
                        
                        <div class="space-y-2">
                            <button onclick="openModal('income')" class="w-full text-left px-4 py-3 rounded-xl bg-indigo-50 dark:bg-indigo-950/50 text-indigo-700 dark:text-indigo-300 hover:bg-indigo-100 dark:hover:bg-indigo-900/60 transition flex items-center justify-between font-medium text-sm">
                                <span><i class="fa-solid fa-plus mr-2"></i>Registrar Recebimento / Vale</span>
                                <i class="fa-solid fa-arrow-right text-xs"></i>
                            </button>
                            <button onclick="openModal('fixed')" class="w-full text-left px-4 py-3 rounded-xl bg-purple-50 dark:bg-purple-950/50 text-purple-700 dark:text-purple-300 hover:bg-purple-100 dark:hover:bg-purple-900/60 transition flex items-center justify-between font-medium text-sm">
                                <span><i class="fa-solid fa-plus mr-2"></i>Nova Conta Fixa</span>
                                <i class="fa-solid fa-arrow-right text-xs"></i>
                            </button>
                            <button onclick="openModal('variable')" class="w-full text-left px-4 py-3 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 hover:bg-emerald-100 dark:hover:bg-emerald-900/60 transition flex items-center justify-between font-medium text-sm">
                                <span><i class="fa-solid fa-plus mr-2"></i>Lançar Gasto Variável</span>
                                <i class="fa-solid fa-arrow-right text-xs"></i>
                            </button>
                            <button onclick="openModal('events')" class="w-full text-left px-4 py-3 rounded-xl bg-amber-50 dark:bg-amber-950/50 text-amber-700 dark:text-amber-300 hover:bg-amber-100 dark:hover:bg-amber-900/60 transition flex items-center justify-between font-medium text-sm">
                                <span><i class="fa-solid fa-plus mr-2"></i>Planejar Evento / Festa</span>
                                <i class="fa-solid fa-arrow-right text-xs"></i>
                            </button>
                        </div>
                    </div>

                    <div class="mt-6 p-4 rounded-xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800/50 text-amber-800 dark:text-amber-200 text-xs leading-relaxed">
                        <i class="fa-solid fa-lightbulb text-amber-500 mr-1.5"></i>
                        <strong>Dica para o casal:</strong> Os Vales Alimentação (VA) e Refeição (VR) são deduzidos automaticamente apenas nas categorias de supermercado e restaurantes.
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= RECEBIMENTOS & VALES TAB ================= -->
        <section id="content-income" class="tab-content space-y-6 hidden">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <h2 class="text-xl font-bold text-gray-900 dark:text-white">Recebimentos e Vales do Mês</h2>
                    <p class="text-sm text-gray-500 dark:text-gray-400">Cadastre a renda líquida e os benefícios do casal (VA e VR).</p>
                </div>
                <button onclick="openModal('income')" class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-sm font-semibold shadow-sm transition flex items-center justify-center gap-2">
                    <i class="fa-solid fa-plus"></i> Adicionar Recebimento
                </button>
            </div>

            <!-- Table for Incomes -->
            <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse text-sm">
                        <thead>
                            <tr class="bg-gray-50 dark:bg-gray-700/50 text-gray-500 dark:text-gray-400 font-semibold text-xs border-b border-gray-200 dark:border-gray-700">
                                <th class="p-4">Descrição</th>
                                <th class="p-4">Responsável</th>
                                <th class="p-4">Tipo de Fonte</th>
                                <th class="p-4">Regra de Uso</th>
                                <th class="p-4 text-right">Valor Líquido</th>
                                <th class="p-4 text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody id="incomeTableBody" class="divide-y divide-gray-100 dark:divide-gray-700/60">
                            <!-- JS injects rows -->
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- ================= CONTAS FIXAS TAB ================= -->
        <section id="content-fixed" class="tab-content space-y-6 hidden">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <h2 class="text-xl font-bold text-gray-900 dark:text-white">Contas Fixas Mensais</h2>
                    <p class="text-sm text-gray-500 dark:text-gray-400">Contas recorrentes do casal (Aluguel, Luz, Internet, etc.)</p>
                </div>
                <button onclick="openModal('fixed')" class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-sm font-semibold shadow-sm transition flex items-center justify-center gap-2">
                    <i class="fa-solid fa-plus"></i> Adicionar Conta Fixa
                </button>
            </div>

            <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse text-sm">
                        <thead>
                            <tr class="bg-gray-50 dark:bg-gray-700/50 text-gray-500 dark:text-gray-400 font-semibold text-xs border-b border-gray-200 dark:border-gray-700">
                                <th class="p-4">Conta</th>
                                <th class="p-4">Vencimento</th>
                                <th class="p-4">Categoria</th>
                                <th class="p-4">Fonte de Pago</th>
                                <th class="p-4">Status</th>
                                <th class="p-4 text-right">Valor</th>
                                <th class="p-4 text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody id="fixedTableBody" class="divide-y divide-gray-100 dark:divide-gray-700/60">
                            <!-- JS injects rows -->
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- ================= GASTOS VARIADOS TAB ================= -->
        <section id="content-variable" class="tab-content space-y-6 hidden">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <h2 class="text-xl font-bold text-gray-900 dark:text-white">Gastos Variados e Dia a Dia</h2>
                    <p class="text-sm text-gray-500 dark:text-gray-400">Mercado, restaurantes, farmácia e pequenas despesas do dia a dia.</p>
                </div>
                <button onclick="openModal('variable')" class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-sm font-semibold shadow-sm transition flex items-center justify-center gap-2">
                    <i class="fa-solid fa-plus"></i> Lançar Gasto Variável
                </button>
            </div>

            <!-- Filters -->
